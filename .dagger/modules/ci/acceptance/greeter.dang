type Greeter {
  """
  Returns a greeting for the name.
  """
  hello(name: String!): String! {
    "hello, " + name
  }

  """
  Lists the entries at the root of a directory.
  """
  entries(source: Directory! @defaultPath(path: "/") @ignorePatterns(patterns: ["*.md"])): [String!]! {
    source.entries
  }
}
